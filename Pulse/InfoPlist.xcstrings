    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID wird verwendet, um Pulse zu entsperren, damit nur du deine Einträge sehen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Face ID is used to unlock Pulse so only you can see your journal entries."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy – Health Share; required by App Review whenever HealthKit is used, although Pulse never reads",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse liest keine Daten aus Health. Pulse speichert nur, jeweils wenn du es einschaltest, die Stimmungsbewertung jedes Moments als Gemütszustand und die Zeit deiner Reflexion als Minuten der Achtsamkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse does not read any data from Health. It only saves, each only if you turn it on, the mood rating of each moment as State of Mind and the time spent on your reflection as Mindful Minutes."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy – Health Update State of Mind from Log Entries",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse kann zwei Dinge in der Health-App speichern, jeweils nur, wenn du es einschaltest: die Stimmungsbewertung jedes Moments als Gemütszustand und die Zeit deiner Reflexion als Minuten der Achtsamkeit. Pulse liest keine Daten aus Health."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse can save two things in the Health app, each only if you turn it on: the mood rating of each moment as State of Mind, and the time spent on your reflection as Mindful Minutes. Pulse never reads data from Health."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort wird lokal mit deinen Einträgen gespeichert, um dir ein vollständiges Bild deines Tages zu geben. Deine Daten bleiben dabei ganz bei dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your location is saved locally with your entries to provide a complete picture of your day. Your data stays private and on your device."
          }
        }
      }
    }
  },
  "version" : "1.1"
}