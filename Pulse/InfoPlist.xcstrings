    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID wird verwendet, um Pulse zu entsperren, damit nur du deine Einträge sehen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Face ID is used to unlock Pulse so only you can see your journal entries."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy – Health Share; required by App Review whenever HealthKit is used, although Pulse never reads",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse liest keine Daten aus Health. Pulse speichert nur die Stimmungsbewertung jedes erfassten Moments als Gemütszustand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse does not read any data from Health. It only saves the mood rating of each moment you log as a State of Mind entry."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy – Health Update State of Mind from Log Entries",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse speichert die Stimmungsbewertung jedes erfassten Moments als Gemütszustand in der Health-App. Pulse liest keine Daten aus Health."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse saves the mood rating of each moment you log as a State of Mind entry in the Health app. Pulse never reads data from Health."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort wird lokal mit deinen Einträgen gespeichert, um dir ein vollständiges Bild deines Tages zu geben. Deine Daten bleiben dabei ganz bei dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your location is saved locally with your entries to provide a complete picture of your day. Your data stays private and on your device."
          }
        }
      }
    }
